# ============================================================================
# PartyNode Community Self-Hosted Game Node Configuration
# ============================================================================

# Outbound WebSocket URL to the official PartyNode Gateway
# (Copied automatically from the "Host Node" modal inside Discord!)
GATEWAY_WS_URL=wss://partynode.yourdomain.com/ws/node

# Server Pairing Token generated in Discord ("Host Node" -> "Generate Server Pairing Token")
PAIRING_TOKEN=pn_paste_your_server_pairing_token_here

# Friendly display name shown in your Discord server's green status badge
NODE_NAME=My Community PartyNode

# Local port for the Web Pack Studio (http://localhost:8080)
NODE_PORT=8080

# Optional password/API key to protect http://localhost:8080 on shared LANs
NODE_ADMIN_KEY=

# Optional AI Pack Generator (Gemini 3.8 Flash OR local Ollama / OpenAI-compatible server)
GEMINI_API_KEY=
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
